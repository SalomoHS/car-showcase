{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "\n# 🟢 Application Health\n"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 1,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          [ "AWS/ApiGateway", "Count", "ApiName", "http://virtual-dealer-backend.vpssalomo.cloud/", { "stat": "Sum", "label": "Request Rate" } ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "ap-southeast-1",
        "title": "Request Rate"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 1,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          [ "AWS/ApiGateway", "5XXError", "ApiName", "http://virtual-dealer-backend.vpssalomo.cloud/", { "stat": "Sum", "color": "#d13212", "label": "5XX Errors" } ],
          [ ".", "4XXError", ".", ".", { "stat": "Sum", "color": "#ff9896", "label": "4XX Errors" } ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "ap-southeast-1",
        "title": "Error Rate"
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 1,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          [ "AWS/ApiGateway", "Latency", "ApiName", "http://virtual-dealer-backend.vpssalomo.cloud/", { "stat": "p50", "label": "p50" } ],
          [ "...", { "stat": "p95", "label": "p95" } ],
          [ "...", { "stat": "p99", "label": "p99" } ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "ap-southeast-1",
        "title": "Latency Percentiles"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 7,
      "width": 24,
      "height": 1,
