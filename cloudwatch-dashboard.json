        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "ap-southeast-1",
        "title": "DynamoDB Consumed Capacity"
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 8,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          [ "AWS/S3", "BucketSizeBytes", "StorageType", "StandardStorage", "BucketName", "virtual-dealer-cars-rag-prod", { "stat": "Average" } ],
          [ ".", ".", ".", ".", ".", "<NAMA_BUCKET_S3_VECTOR>", { "stat": "Average" } ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "ap-southeast-1",
        "title": "S3 & S3 Vector Bucket Size"
      }
