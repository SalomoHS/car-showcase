        "view": "timeSeries",
        "stacked": false,
        "region": "ap-southeast-1",
        "title": "Total RAG Requests"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 21,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "\n# 💰 Cost & Billing\n"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 22,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [ "AWS/Billing", "EstimatedCharges", "Currency", "USD", { "stat": "Maximum" } ]
        ],
        "view": "singleValue",
        "region": "ap-southeast-1",
        "title": "Total Cost MTD (USD)"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 22,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [ "AWS/Billing", "EstimatedCharges", "ServiceName", "AmazonEC2", "Currency", "USD", { "stat": "Maximum" } ],
          [ ".", ".", ".", "AmazonDynamoDB", ".", ".", { "stat": "Maximum" } ],
          [ ".", ".", ".", "AmazonS3", ".", ".", { "stat": "Maximum" } ],
          [ "Langfuse/Cost", "EstimatedCharges", "ServiceName", "LLM", "Currency", "USD", { "stat": "Maximum" } ]
        ],
        "view": "pie",
        "region": "ap-southeast-1",
        "title": "Cost Breakdown per Service"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 28,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "\n# 📜 Recent Logs & 🚨 Alarms\n"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 29,
      "width": 12,
      "height": 8,
      "properties": {
        "query": "SOURCE '<NAMA_LOG_GROUP_KAMU>' | fields @timestamp, tenantId, @message\n| filter @message like /(?i)(ERROR|WARN)/\n| sort @timestamp desc\n| limit 50",
        "region": "ap-southeast-1",
        "title": "Recent Error/Warn Logs (Multi-tenant)",
        "view": "table"
      }
    },
    {
      "type": "alarm",
      "x": 12,
      "y": 29,
      "width": 12,
      "height": 8,
      "properties": {
        "alarms": [
          "<ARN_ALARM_CPU_KAMU>",
          "<ARN_ALARM_DYNAMODB_KAMU>"
        ],
        "title": "System Alarms Status"
      }
    }
  ]
}